</TABLE>>
,height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classrepresentation_1_1Camera.html",tooltip="Handles coordinate conversions between world-space and window screen-space."];
  Node3 -> Node1 [id="edge2_Node000001_Node000003",color="steelblue1",style="solid",tooltip=" ",label=" -stateManager_",fontcolor="grey" ,arrowhead="odiamond"];
